# ── PostgreSQL — deux bases distinctes sur le même serveur ──────────
# SOURCE : base OLTP (back-office), lue par l'ETL.
# DEST   : base analytique (destination ETL), celle que sert l'API.
{{ cookiecutter.env_prefix }}SOURCE_POSTGRES_URI=postgresql://postgres:change_me@localhost:5432/{{ cookiecutter.__project_snake }}_source
{{ cookiecutter.env_prefix }}DEST_POSTGRES_URI=postgresql://postgres:change_me@localhost:5432/{{ cookiecutter.__project_snake }}_analytics
{%- if cookiecutter.include_etl == "y" %}

# ── ETL — schémas lus/écrits par etl/run_etl.py ──────────────────────
{{ cookiecutter.env_prefix }}SOURCE_SCHEMA=public
{{ cookiecutter.env_prefix }}DEST_SCHEMA={{ cookiecutter.analytics_schema }}
{%- endif %}

# ── Table analytique — schéma + noms de table lus par l'API ─────────
{{ cookiecutter.env_prefix }}ANALYTICS_SCHEMA={{ cookiecutter.analytics_schema }}
{{ cookiecutter.env_prefix }}TABLE_FACT_EXAMPLE=fact_example

# ── Redis ─────────────────────────────────────────────────────────
{{ cookiecutter.env_prefix }}REDIS_HOST=localhost
{{ cookiecutter.env_prefix }}REDIS_PORT={{ cookiecutter.redis_host_port }}
{{ cookiecutter.env_prefix }}REDIS_DB=0
{{ cookiecutter.env_prefix }}REDIS_TTL=300
{{ cookiecutter.env_prefix }}REDIS_KEY_PREFIX={{ cookiecutter.__project_snake }}:
# Port hôte publié par docker-compose pour Redis
{{ cookiecutter.env_prefix }}REDIS_HOST_PORT={{ cookiecutter.redis_host_port }}

# ── Documentation ─────────────────────────────────────────────────
# Port hôte publié par docker-compose pour le serveur MkDocs (profil "docs")
{{ cookiecutter.env_prefix }}DOCS_PORT={{ cookiecutter.docs_port }}

# ── API ───────────────────────────────────────────────────────────
{{ cookiecutter.env_prefix }}PROJECT_NAME="{{ cookiecutter.project_name }}"
{{ cookiecutter.env_prefix }}API_V1_STR=/api/v1
{{ cookiecutter.env_prefix }}SECRET_KEY=generate_a_secure_key_here_never_commit_the_real_one

# ── JWT ───────────────────────────────────────────────────────────
{{ cookiecutter.env_prefix }}ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ── App ───────────────────────────────────────────────────────────
{{ cookiecutter.env_prefix }}COMPANY_NAME="{{ cookiecutter.company_name }}"

# ── CORS ──────────────────────────────────────────────────────────
{{ cookiecutter.env_prefix }}BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:{{ cookiecutter.api_port }}"]
